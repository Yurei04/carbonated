{
  "manifest_version": 3,
  "name": "Privacy Curtain - Mindful Browsing",
  "version": "1.0.0",
  "description": "Covers websites with a privacy curtain to prevent overuse and protect your privacy",
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["curtain.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "index.html"
  }
}